config FORAGER_BATTERY_RESEND
    bool "Re-send this half's battery level to the dongle"
    default y
    depends on ZMK_SPLIT && !ZMK_SPLIT_ROLE_CENTRAL && ZMK_BATTERY_REPORTING
    help
      ZMK only sends a peripheral's battery level when the level changes
      (and once at boot). Over BLE the central fetches it on connect, but
      ESB is connectionless, so a dongle powered on after the halves would
      show no battery until the level next changes. This re-sends the
      current level after a pause in typing, when the last send is old
      enough.

if FORAGER_BATTERY_RESEND

config FORAGER_BATTERY_RESEND_MIN_GAP_S
    int "Seconds between re-sends, at least"
    default 60

config FORAGER_BATTERY_RESEND_QUIET_MS
    int "Send once no key on this half changed for this many milliseconds"
    default 2000

endif
