if SHIELD_FORAGER_CENTRAL_DONGLE

config ZMK_KEYBOARD_NAME
    default "Forager"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

config ZMK_STUDIO
    default y

# Skipped when paired with prospector_adapter: that shield brings its own
# ST7789V color display and LVGL config, which would otherwise conflict with
# the SSD1306 defaults below (e.g. both set a default for LV_COLOR_DEPTH).
if ZMK_DISPLAY && !SHIELD_PROSPECTOR_ADAPTER

config I2C
    default y

config SSD1306
    default y

choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

endif # ZMK_DISPLAY && !SHIELD_PROSPECTOR_ADAPTER

if SSD1306

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # SSD1306

endif # SHIELD_FORAGER_CENTRAL_DONGLE
