#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/*                                      34 KEY MATRIX / LAYOUT MAPPING
                                     (based on totem, minus LB5/RB5 and LH2/RH2)

    ╭──────────────────────┬─────────────────────╮
    │  LT4 LT3 LT2 LT1 LT0 │ RT0 RT1 RT2 RT3 RT4 │
    │  LM4 LM3 LM2 LM1 LM0 │ RM0 RM1 RM2 RM3 RM4 │
    │  LB4 LB3 LB2 LB1 LB0 │ RB0 RB1 RB2 RB3 RB4 │
    ╰───────╮      LH1 LH0 │ RH0 RH1 ╭───────────╯
            ╰──────────────┴─────────╯
*/

#define LT0  4  // left-top row + appendix
#define LT1  3
#define LT2  2
#define LT3  1
#define LT4  0

#define RT0  5 // right-top row + appendix
#define RT1  6
#define RT2  7
#define RT3  8
#define RT4  9

#define LM0 14  // left-middle row
#define LM1 13
#define LM2 12
#define LM3 11
#define LM4 10

#define RM0 15  // right-middle row
#define RM1 16
#define RM2 17
#define RM3 18
#define RM4 19

#define LB0 24  // left-bottom row
#define LB1 23
#define LB2 22
#define LB3 21
#define LB4 20

#define RB0 25  // right-bottom row
#define RB1 26
#define RB2 27
#define RB3 28
#define RB4 29

#define LH0 31  // left thumb keys
#define LH1 30

#define RH0 32  // right thumb keys
#define RH1 33

#define NUMROW
#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4
#define THUMBS_L LH0 LH1
#define THUMBS_R RH0 RH1
#define THUMBS THUMBS_L THUMBS_R

#define LHPR &kp LS(LA(LC(LGUI)))
#define RHPR &kp (RA(RC(RGUI)))
#define HPR_G &hml LS(LA(LC(LGUI))) G
#define HPR_H &hmr RS(RA(RC(RGUI))) H
#define NAV_SPC &lt NAV SPACE
#define NUM_TAB &lt NUM TAB

#define XXX &none
#define ___ &trans

#define BASE 0
#define NAV 1
#define NUM 2
#define BRAC 3
#define FUN 4

/ {
    behaviors {
        // #define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4 // left hand
        // #define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4 // right hand
        // #define THUMBS LH1 LH0 RH0 RH1                                            // thumbs

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    macros {};

    /*                   KEY POSITIONS
        ╭──────────────────────┬─────────────────────╮
        │  LT4 LT3 LT2 LT1 LT0 │ RT0 RT1 RT2 RT3 RT4 │
        │  LM4 LM3 LM2 LM1 LM0 │ RM0 RM1 RM2 RM3 RM4 │
        │  LB4 LB3 LB2 LB1 LB0 │ RB0 RB1 RB2 RB3 RB4 │
        ╰───────────╮  LH1 LH0 │ RH0 RH1 ╭───────────╯
                    ╰──────────┴─────────╯

    */

    combos {
        compatible = "zmk,combos";
        combo_esc_1 {
            timeout-ms = <50>;
            key-positions = <LM4 LM3>;
            bindings = <&mt LC(LALT) ESC>;
        };
        combo_esc_2 {
            timeout-ms = <50>;
            key-positions = <LM3 LM2>;
            bindings = <&mt LA(LGUI) ESC>;
        };
        combo_tab {
            timeout-ms = <50>;
            key-positions = <LM2 LM1>;
            bindings = <&mt LS(LGUI) TAB>;
        };
        combo_ent {
            timeout-ms = <50>;
            key-positions = <RM1 RM2>;
            bindings = <&mt RS(RGUI) ENTER>;
        };
        combo_bspc {
            timeout-ms = <50>;
            key-positions = <RM2 RM3>;
            bindings = <&mt RS(RGUI) BSPC>;
        };
        combo_left_screen {
            timeout-ms = <50>;
            key-positions = <RB1 RB2>;
            bindings = <&kp LC(LEFT)>;
        };
        combo_right_screen {
            timeout-ms = <50>;
            key-positions = <RB2 RB3>;
            bindings = <&kp LC(LEFT)>;
        };
        combo_go_back {
            timeout-ms = <50>;
            key-positions = <RT1 RT2>;
            bindings = <&kp LG(LS(LBKT))>;
        };
        combo_go_forward {
            timeout-ms = <50>;
            key-positions = <RT2 RT3>;
            bindings = <&kp LG(LS(RBKT))>;
        };
        combo_copy {
            timeout-ms = <50>;
            key-positions = <LB2 LB1>;
            bindings = <&kp LG(C)>;
        };
        combo_paste {
            timeout-ms = <50>;
            key-positions = <LB3 LB1>;
            bindings = <&kp LG(V)>;
        };
        combo_cut {
            timeout-ms = <50>;
            key-positions = <LB3 LB2>;
            bindings = <&kp LG(X)>;
        };
        combo_undo {
            timeout-ms = <50>;
            key-positions = <LB4 LB3>;
            bindings = <&kp LG(Z)>;
        };
        combo_studio {
            timeout-ms = <50>;
            key-positions = <LT0 RT0>;
            bindings = <&studio_unlock>;
        };
        combo_grave {
            timeout-ms = <50>;
            key-positions = <LT4 LT3>;
            bindings = <&kp GRAVE>;
        };
        combo_apos {
            timeout-ms = <50>;
            key-positions = <RT3 RT4>;
            bindings = <&kp APOS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
//                       ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
                           &kp Q         &kp W         &kp E         &kp R         &kp T             &kp Y         &kp U         &kp I         &kp O         &kp P
//                       ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                           &hml LCTRL A  &hml LALT S   &hml LGUI D   &hml LSHFT F  HPR_G             HPR_H         &hmr RSHFT J  &hmr RGUI  K  &hmr RALT L   &hmr RCTRL SEMI
//                       ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                           &kp Z         &kp X         &kp C         &kp V         &kp B             &kp N         &kp M         &kp COMMA     &kp DOT       &kp FSLH
//                       ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                                                     NAV_SPC       NUM_TAB           &lt FUN BSPC  &lt BRAC SPACE
//                                                                 ╰─────────────┴─────────────╯   ╰─────────────┴─────────────╯
            >;
        };

        nav_layer {
            label = "NAV";
            bindings = <
//                       ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
                           XXX           XXX           XXX           XXX           XXX               XXX           &kp HOME      &kp PG_DN     &kp PG_UP     &kp END
//                       ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                           &kp LCTRL     &kp LALT      &kp LGUI      &kp LSHFT     LHPR              XXX           &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT
//                       ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                           XXX           XXX           XXX           XXX           XXX               XXX           XXX           XXX           XXX           XXX
//                       ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                                                     XXX           XXX               &kp BSPC      &kp SPACE
//                                                                 ╰─────────────┴─────────────╯   ╰─────────────┴─────────────╯
            >;
        };

        num_layer {
            label = "NUM";
            bindings = <
//                       ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
                           XXX           XXX           XXX           XXX           XXX               XXX           &kp N7        &kp N8        &kp N9        &kp MINUS
//                       ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                           &kp LCTRL      &kp LALT      &kp LGUI     &kp LSHFT     LHPR              XXX           &kp N4        &kp N5        &kp N6        &kp PLUS
//                       ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                           XXX           XXX           XXX           XXX           XXX               &kp N0        &kp N1        &kp N2        &kp N3        &kp BSLH
//                       ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                                                     XXX           XXX               &kp BSPC      &kp SPACE
//                                                                 ╰─────────────┴─────────────╯   ╰─────────────┴─────────────╯
            >;
        };

        brac_layer {
            label = "BRAC";
            bindings = <
//                       ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
                           XXX           XXX           &kp LPAR      &kp RPAR      XXX               XXX           XXX           XXX           XXX           XXX
//                       ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                           &kp LT        &kp GT        &kp LBRC      &kp RBRC      XXX               RHPR          &kp RSHFT     &kp LGUI      &kp LALT      &kp RCTRL
//                       ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                           XXX           XXX           &kp LBKT      &kp RBKT      XXX               XXX           XXX           XXX           XXX           XXX
//                       ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                                                     &kp SPACE     &kp TAB           XXX           XXX
//                                                                 ╰─────────────┴─────────────╯   ╰─────────────┴─────────────╯
            >;
        };

        fun_layer {
            label = "FUN";
            bindings = <
//                       ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
                           &kp F12       &kp F7        &kp F8        &kp F9        XXX               XXX           XXX           XXX           XXX           XXX
//                       ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                           &kp F11       &kp F4        &kp F5        &kp F6        XXX               RHPR          &kp RSHFT     &kp LGUI      &kp LALT      &kp RCTRL
//                       ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                           &kp F10       &kp F1        &kp F2        &kp F3        XXX               XXX           XXX           XXX           XXX           XXX
//                       ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                                                     &kp SPACE     &kp TAB           XXX           XXX
//                                                                 ╰─────────────┴─────────────╯   ╰─────────────┴─────────────╯
            >;
        };
    };
};
